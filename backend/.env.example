# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LiteLLM / AI Model Connection ────────────────────────────────────────────
# Set your preferred AI Model and its API Key:
#
# 1. Google Gemini (Recommended):
#    LITELLM_MODEL=gemini/gemini-1.5-flash
#    LITELLM_API_KEY=AIzaSy... (Your Google AI Studio API Key)
#
# 2. OpenAI:
#    LITELLM_MODEL=gpt-4o-mini
#    LITELLM_API_KEY=sk-proj-...
#
# 3. Groq (Ultra-fast Llama 3):
#    LITELLM_MODEL=groq/llama-3.1-70b-versatile
#    LITELLM_API_KEY=gsk_...
#
# 4. Local Ollama (Free, offline):
#    LITELLM_MODEL=ollama/llama3
#    LITELLM_API_KEY=none
#
LITELLM_MODEL=gemini/gemini-1.5-flash
LITELLM_API_KEY=AIzaSy_YOUR_API_KEY_HERE
LITELLM_TEMPERATURE=0.3
LITELLM_MAX_TOKENS=1024

# ── Government Scheme API Integration ────────────────────────────────────────
# Live Government Scheme API endpoint (e.g. MyScheme, India.gov.in, Data.gov.in):
GOVT_SCHEME_API_URL=https://api.myscheme.gov.in/v1/schemes
GOVT_SCHEME_API_KEY=your_govt_api_key_here

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TOKEN_EXPIRY_DAYS=90
